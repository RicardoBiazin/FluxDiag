{
  "name": "fluxdiag",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:desktop": "tsc --noEmit -p . && vite build --base ./",
    "desktop": "npm run build:desktop && node electron/run.cjs",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "test:desktop": "npm run build:desktop && playwright test -c playwright.desktop.config.ts",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "description": "Editor de diagramas e fluxogramas que viram apresentação — web e desktop",
  "author": "Ricardo Biazin",
  "license": "MIT",
  "homepage": "https://github.com/RicardoBiazin/FluxDiag",
  "main": "electron/main.cjs",
  "build": {
    "appId": "br.com.biazin.fluxdiag",
    "productName": "FluxDiag",
    "copyright": "© 2026 Ricardo Biazin",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "FluxDiag-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "FluxDiag-${version}-portatil.${ext}"
    }
  },
  "allowScripts": {
    "electron@45.0.0": true
  }
}
